<Group view="code" hide-input="false" labelreference="L106564" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">LAMBDA := [seq(lambda__c||i(t), i=1..nops(DYNAMIC_SYSTEM))];
HAMILTONIAN := LAGRANGE_TERM + sum(DYNAMIC_SYSTEM_RHS[i]*LAMBDA[i], i=1..nops(DYNAMIC_SYSTEM));</Text-field>
