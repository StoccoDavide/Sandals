<Group view="code" hide-input="false" labelreference="L106593" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">DYNAMIC_SYSTEM     := DYNAMIC_SYSTEM_INDEX_0;
DYNAMIC_SYSTEM_LHS := lhs~(DYNAMIC_SYSTEM):
DYNAMIC_SYSTEM_RHS := rhs~(DYNAMIC_SYSTEM):
DYNAMIC_SYSTEM     := DYNAMIC_SYSTEM_LHS -~ DYNAMIC_SYSTEM_RHS: &lt;%&gt;;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
