<Group view="code" hide-input="false" labelreference="L106531" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">DYNAMIC_SYSTEM_INDEX_3 := [
  diff(x(t), t) = u(t),
  diff(y(t), t) = v(t),
  diff(u(t), t) = -2*x(t)*lambda(t) + l*y(t)*f(t),
  diff(v(t), t) = -g - 2*y(t)*lambda(t) - l*x(t)*f(t),
              0 = l^2 - x(t)^2 - y(t)^2
]: &lt;%&gt;;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
