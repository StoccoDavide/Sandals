<Group view="code" hide-input="false" labelreference="L106596" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">INV_3 := rhs(subs(DYNAMIC_SYSTEM_INDEX_1[1..4], diff(DYNAMIC_SYSTEM_INDEX_1[-1], t)));
DYNAMIC_SYSTEM_INDEX_0 := [
  op(DYNAMIC_SYSTEM_INDEX_1[1..4]), isolate(INV_3, diff(lambda(t), t))
]: &lt;%&gt;;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
