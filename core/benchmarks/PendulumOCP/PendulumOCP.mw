<Group view="code" hide-input="false" labelreference="L106575" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">DIFF_VARS := [op(VARS), op(LAMBDA)];
(*RM_DEPT := [
  seq(diff(DIFF_VARS[i], t) = x__||(i-1)||__dot, i=1..nops(DIFF_VARS)),
  seq(eval(DIFF_VARS[i]) = x__||(i-1), i=1..nops(DIFF_VARS)),
  seq(eval(subs(t=T_INI, DIFF_VARS[i])) = x__||(i-1)||__ini, i=1..nops(DIFF_VARS)),
  seq(eval(subs(t=T_END, DIFF_VARS[i])) = x__||(i-1)||__end, i=1..nops(DIFF_VARS))
];*)
RM_DEPT := [
  seq(diff(DIFF_VARS[i], t) = x_dot[i], i=1..nops(DIFF_VARS)),
  seq(eval(DIFF_VARS[i]) = x[i], i=1..nops(DIFF_VARS)),
  seq(eval(subs(t=T_INI, DIFF_VARS[i])) = x_ini[i], i=1..nops(DIFF_VARS)),
  seq(eval(subs(t=T_END, DIFF_VARS[i])) = x_end[i], i=1..nops(DIFF_VARS))
];


</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group view="code" hide-input="false" labelreference="L106607" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">IMPLICIT_F := simplify(convert(subs(RM_DEPT, simplify(eval(convert(subs(BVP_CONTROL_SOLVED, [
  op(BVP_DYNAMICS),
  op(BVP_ADJOINTS)
]), diff)), size)), Vector));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group view="code" labelreference="L106581" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">CodeGeneration:-Translate(IMPLICIT_F,
  resultname        = &quot;F&quot;,
  language          = &quot;C&quot;,
  optimize          = false,
  digits            = 30,
  deducereturn      = false,
  coercetypes       = false,
  deducetypes       = false,
  reduceanalysis    = false,
  defaulttype       = numeric,
  functionprecision = double
);</Text-field>
</Input>
<Output><Text-field style="HyperlinkWarning" layout="HyperlinkWarning"><Hyperlink linktarget="http://www.maplesoft.com/support/help/errors/view.aspx?path=Warning,%20cannot%20resolve%20types,%20reassigning%20F's%20type" hyperlink="true"><Font style="HyperlinkWarning">Warning, cannot resolve types, reassigning F's type</Font></Hyperlink></Text-field>
</Output>
<Output><Text-field style="Line Printed Output" layout="Line Printed Output">F[0] = x_dot[0] - x[2];
F[1] = x_dot[1] - x[3];
F[2] = x_dot[2] + (-l * l * x[8] * x[1] + 4 * x[4]) * x[0] / 2 + l * l * x[1] * x[1] * x[7] / 2;
F[3] = (x[0] * x[0] * x[8] - x[0] * x[1] * x[7]) * l * l / 2 + 2 * x[1] * x[4] + g + x_dot[3];
F[4] = -l * l + x[0] * x[0] + x[1] * x[1];
F[5] = (-l * l * x[8] * x[8] - 4 * x[9]) * x[0] / 2 + (l * l * x[8] * x[1] - 4 * x[4]) * x[7] / 2 + x_dot[5];
F[6] = (-l * l * x[7] * x[7] - 4 * x[9]) * x[1] / 2 + l * l * x[7] * x[0] * x[8] / 2 - 2 * x[4] * x[8] + x_dot[6];
F[7] = x_dot[7] + x[5];
F[8] = x_dot[8] + x[6];
F[9] = -2 * x[0] * x[7] - 2 * x[1] * x[8] + x_dot[9];
</Text-field>
</Output>
</Group>
<Group view="code" hide-input="false" labelreference="L106577" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">JACOBIAN_F_X := simplify(Sandals:-DoJacobian(IMPLICIT_F, [seq(x[i], i=1..nops(DIFF_VARS))]));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
