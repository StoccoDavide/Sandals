<Group view="code" hide-input="false" labelreference="L106562" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">BVP_CONTRAINTS := [
  op(convert(Sandals:-DoGradient(CONSTRAINTS, subs(t=T_INI, VARS)), list) +~ subs(t=T_INI, LAMBDA)),
  op(convert(Sandals:-DoGradient(CONSTRAINTS, subs(t=T_END, VARS)), list) -~ subs(t=T_END, LAMBDA))
]: &lt;%&gt;;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group view="code" hide-input="false" labelreference="L106563" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">BVP_CONTROL := op(convert(Sandals:-DoGradient(HAMILTONIAN, CONTROL), list)):
BVP_CONTROL_SOLVED := op(solve(%, CONTROL));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group view="code" hide-input="false" labelreference="L106621" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">DIFF_VARS := [op(VARS), op(LAMBDA)];
RM_DEPT := [
  seq(diff(DIFF_VARS[i], t) = x_dot[i], i=1..nops(DIFF_VARS)),
  seq(eval(DIFF_VARS[i]) = x[i], i=1..nops(DIFF_VARS)),
  seq(eval(subs(t=T_INI, DIFF_VARS[i])) = x_ini[i], i=1..nops(DIFF_VARS)),
  seq(eval(subs(t=T_END, DIFF_VARS[i])) = x_end[i], i=1..nops(DIFF_VARS))
];</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group view="code" hide-input="false" labelreference="L106607" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">IMPLICIT_F := simplify(convert(subs(BVP_CONTROL_SOLVED, RM_DEPT, [  op(BVP_DYNAMICS),  op(BVP_ADJOINTS)]), Vector));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group view="code" labelreference="L106581" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">CodeGeneration:-Translate(IMPLICIT_F,
  resultname        = &quot;F&quot;,
  language          = &quot;C&quot;,
  optimize          = false,
  digits            = 30,
  deducereturn      = false,
  coercetypes       = false,
  deducetypes       = false,
  reduceanalysis    = false,
  defaulttype       = numeric,
  functionprecision = double
);</Text-field>
</Input>
<Output><Text-field style="HyperlinkWarning" layout="HyperlinkWarning"><Hyperlink linktarget="http://www.maplesoft.com/support/help/errors/view.aspx?path=Warning,%20cannot%20resolve%20types,%20reassigning%20F's%20type" hyperlink="true"><Font style="HyperlinkWarning">Warning, cannot resolve types, reassigning F's type</Font></Hyperlink></Text-field>
</Output>
<Output><Text-field style="Line Printed Output" layout="Line Printed Output">F[0] = x_dot[0] - x[2];
F[1] = x_dot[1] - x[3];
F[2] = (pow(x[1], 4) * x[7] - x[0] * pow(x[1], 3) * x[8] + (x[0] * x[0] * x[7] + 4 * x[0] * x[4] + x[2] * x[9] + 2 * x_dot[2]) * x[1] * x[1] + (-pow(x[0], 3) * x[8] - x[0] * x[3] * x[9]) * x[1] + 4 * pow(x[0], 3) * x[4] + 2 * x[0] * x[0] * x_dot[2]) / (2 * x[0] * x[0] + 2 * x[1] * x[1]);
