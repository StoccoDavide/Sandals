<Group view="code" hide-input="false" labelreference="L106531" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">DYNAMIC_SYSTEM := [
  diff(x__1(t), t) = -10*x__1(t) + u__1(t) + u__2(t),
  diff(x__2(t), t) = -2*x__2(t) + u__1(t) + 2*u__2(t),
  diff(x__3(t), t) = -3*x__3(t) + 5*x__4(t) + u__1(t) - u__2(t),
  diff(x__4(t), t) = 5*x__3(t) - 3 *x__4(t) + u__1(t) + 3*u__2(t)
]: &lt;%&gt;;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group view="code" hide-input="false" labelreference="L106593" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">DYNAMIC_SYSTEM_LHS := lhs~(DYNAMIC_SYSTEM):
DYNAMIC_SYSTEM_RHS := rhs~(DYNAMIC_SYSTEM):
DYNAMIC_SYSTEM     := DYNAMIC_SYSTEM_LHS -~ DYNAMIC_SYSTEM_RHS: &lt;%&gt;;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group view="code" hide-input="false" labelreference="L106532" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">BOUNDARY_CONDITIONS := [
  x__1(0) - 2, 
  x__2(0) - 1,
  x__3(0) - 2,
  x__4(0) - 1,
  x__1(20) - 2, 
  x__2(20) - 3,
  x__3(20) - 1,
  x__4(20) + 2
]: &lt;%&gt;;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group view="code" hide-input="false" labelreference="L106614" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">p := (t, a, b) -&gt; exp(-b*(t-a)^2);
INEQUALITY_CONSTRAINTS := [
  sum(VARS[i]^2,  i=1..nops(VARS)) - 3*p(t, 3, 12) - 3*p(t, 6, 10) - 3*p(t, 10, 6) - 8*p(t, 15, 4) - 10^(-2)
]; &lt;% &gt;=~ 0&gt;;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSJwR0YoZio2JUkidEdGKEkiYUdGKEkiYkdGKEYoNiRJKW9wZXJhdG9yR0YoSSZhcnJvd0dGKEYoLUkkZXhwR0YlNiMsJComOSYiIiIsJjkkRjw5JSEiIiIiI0ZARihGKEYoNyNGLg==</Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group></Presentation-Block>
