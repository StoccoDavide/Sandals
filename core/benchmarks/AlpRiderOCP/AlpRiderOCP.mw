<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 1" layout="Heading 1">OCP Solution</Text-field></Title><Presentation-Block>
<Group view="code" hide-input="false" labelreference="L106564" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">LAMBDA := [seq(lambda__c||i(t), i=1..nops(DYNAMIC_SYSTEM))];
HAMILTONIAN := LAGRANGE_TERM + sum(DYNAMIC_SYSTEM_RHS[i]*LAMBDA[i], i=1..nops(DYNAMIC_SYSTEM)) - mu*sum(log(INEQUALITY_CONSTRAINTS[i]), i=1..nops(INEQUALITY_CONSTRAINTS));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSdMQU1CREFHRig3Ji1JK2xhbWJkYV9fYzFHRig2I0kidEdGKC1JK2xhbWJkYV9fYzJHRihGMS1JK2xhbWJkYV9fYzNHRihGMS1JK2xhbWJkYV9fYzRHRihGMTcjRi4=</Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group view="code" hide-input="false" labelreference="L106565" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">MU := [seq(mu__c||i(t), i=1..nops(BOUNDARY_CONDITIONS))];
CONSTRAINTS := MAYER_TERM + sum(BOUNDARY_CONDITIONS[i]*MU[i], i=1..nops(BOUNDARY_CONDITIONS));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSNNVUdGKDcqLUknbXVfX2MxR0YoNiNJInRHRigtSSdtdV9fYzJHRihGMS1JJ211X19jM0dGKEYxLUknbXVfX2M0R0YoRjEtSSdtdV9fYzVHRihGMS1JJ211X19jNkdGKEYxLUknbXVfX2M3R0YoRjEtSSdtdV9fYzhHRihGMTcjRi4=</Equation></Text-field>
</Output>
