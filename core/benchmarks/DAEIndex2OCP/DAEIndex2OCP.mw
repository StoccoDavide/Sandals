<Group view="code" hide-input="false" labelreference="L106607" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">IMPLICIT_F := simplify(subs(RM_DEPT, eval(subs(BVP_CONTROL_SOLVED, [
  op(BVP_DYNAMICS),
  op(BVP_ADJOINTS)
])))): &lt;%&gt;;#convert(op(solve(IMPLICIT_F, [seq(x_dot[i], i=1..nops(DIFF_VARS))])), Vector):#IMPLICIT_F := lhs~(%) -~ rhs~(%);IMPLICIT_F := convert(IMPLICIT_F, Vector);</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
