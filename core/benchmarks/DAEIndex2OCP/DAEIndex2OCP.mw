<Group view="code" hide-input="false" labelreference="L106565" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">MU := [seq(mu__||i(t), i=1..nops(BOUNDARY_CONDITIONS))];
CONSTRAINTS := MAYER_TERM + sum(BOUNDARY_CONDITIONS[i]*MU[i], i=1..nops(BOUNDARY_CONDITIONS))</Text-field>
</Input>
