<Group view="code" hide-input="false" labelreference="L106531" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">DYNAMIC_SYSTEM_INDEX_2 := [
  diff(x__1(t), t) = x__3(t) - 2*x__1(t)*y__2(t), 
  diff(x__2(t), t) = x__4(t) - 2*x__2(t)*y__2(t), 
  diff(x__3(t), t) = -2*x__1(t)*y__1(t) + u(t)*x__2(t), 
  diff(x__4(t), t) = -g - 2*x__2(t)*y__1(t) - u(t)*x__1(t),
  0 = x__1(t)*x__3(t) + x__2(t)*x__4(t),
  0 = x__1(t)^2 + x__2(t)^2 - 1]: &lt;%&gt;;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
